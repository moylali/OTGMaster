<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. These two are encrypted with keys that stay in this phone's keystore,
     so a copy on another phone can never be read. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="otg_backup_secrets.xml" />
        <exclude domain="sharedpref" path="otg_cred_store.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="otg_backup_secrets.xml" />
        <exclude domain="sharedpref" path="otg_cred_store.xml" />
    </device-transfer>
</data-extraction-rules>
